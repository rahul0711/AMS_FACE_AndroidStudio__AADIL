<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F0F2F5"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="28dp"
        android:paddingBottom="32dp">

        <!-- Recent visits card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeColor="#E2E5EA"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="RECENT"
                    android:textColor="#8A8F9A"
                    android:textSize="10sp"
                    android:textAllCaps="true"
                    android:letterSpacing="0.08" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="@string/my_visit_recent_title"
                    android:textColor="#111827"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/my_visit_recent_hint"
                    android:textColor="#8A8F9A"
                    android:textSize="12sp"
                    android:lineSpacingMultiplier="1.35" />

                <ProgressBar
                    android:id="@+id/progressRecent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="14dp"
                    android:visibility="gone" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Filter card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeColor="#E2E5EA"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="FILTER BY DATE"
                    android:textColor="#8A8F9A"
                    android:textSize="10sp"
                    android:textAllCaps="true"
                    android:letterSpacing="0.08" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:layout_marginBottom="4dp"
                    android:text="@string/my_visit_filter_title"
                    android:textColor="#111827"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="18dp"
                    android:text="@string/my_visit_filter_hint"
                    android:textColor="#8A8F9A"
                    android:textSize="12sp" />

                <!-- Month -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/attendance_filter_month"
                    android:textColor="#8A8F9A"
                    android:textSize="10sp"
                    android:textAllCaps="true"
                    android:letterSpacing="0.08"
                    android:layout_marginBottom="6dp" />

                <Spinner
                    android:id="@+id/spinnerMonth"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginBottom="16dp"

                    android:spinnerMode="dropdown"
                    android:paddingHorizontal="12dp" />

                <!-- Year -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/attendance_filter_year"
                    android:textColor="#8A8F9A"
                    android:textSize="10sp"
                    android:textAllCaps="true"
                    android:letterSpacing="0.08"
                    android:layout_marginBottom="6dp" />

                <Spinner
                    android:id="@+id/spinnerYear"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginBottom="16dp"

                    android:spinnerMode="dropdown"
                    android:paddingHorizontal="12dp" />

                <!-- Day -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/my_visit_filter_day"
                    android:textColor="#8A8F9A"
                    android:textSize="10sp"
                    android:textAllCaps="true"
                    android:letterSpacing="0.08"
                    android:layout_marginBottom="6dp" />

                <Spinner
                    android:id="@+id/spinnerDay"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"

                    android:spinnerMode="dropdown"
                    android:paddingHorizontal="12dp" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Results header: tvVisitSectionTitle + tvVisitCount stay as plain TextViews -->
        <TextView
            android:id="@+id/tvVisitSectionTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="2dp"
            android:textColor="#111827"
            android:textSize="15sp"
            android:textStyle="bold"
            android:visibility="gone"
            tools:text="Visits on 21 May 2026"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/tvVisitCount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:textColor="#8A8F9A"
            android:textSize="12sp"
            android:visibility="gone"
            tools:text="3 visits"
            tools:visibility="visible" />

        <!-- Visit cards injected here -->
        <LinearLayout
            android:id="@+id/layoutVisitList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="visible" />

        <!-- Empty state — plain TextView, activity sets .text and .visibility -->
        <TextView
            android:id="@+id/tvVisitEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingVertical="40dp"
            android:paddingHorizontal="24dp"
            android:text="@string/my_visit_no_data"
            android:textColor="#B0B5BF"
            android:textSize="14sp"
            android:lineSpacingMultiplier="1.4"
            android:background="@drawable/bg_empty_state"
            android:visibility="gone" />

        <!-- Loading spinner for filtered results -->
        <ProgressBar
            android:id="@+id/progressFiltered"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:visibility="gone" />

        <!-- Error state — plain TextView, activity sets .text and .visibility -->
        <TextView
            android:id="@+id/tvVisitError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingVertical="16dp"
            android:paddingHorizontal="20dp"
            android:textColor="#791F1F"
            android:textSize="13sp"
            android:lineSpacingMultiplier="1.35"
            android:background="@drawable/bg_error_banner"
            android:visibility="gone" />

    </LinearLayout>
</ScrollView>